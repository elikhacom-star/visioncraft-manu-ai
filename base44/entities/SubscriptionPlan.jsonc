{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Unique identifier for the plan (e.g. 'free', 'pro', 'enterprise')"
    },
    "name": {
      "type": "string",
      "description": "Display name of the plan"
    },
    "price": {
      "type": "number",
      "description": "Monthly price"
    },
    "monthly_video_limit": {
      "type": "integer",
      "description": "Maximum videos per month"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of features included"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this plan is available"
    }
  },
  "required": [
    "plan_id",
    "name",
    "monthly_video_limit"
  ]
}